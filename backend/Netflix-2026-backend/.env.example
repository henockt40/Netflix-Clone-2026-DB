# Set real values locally, in backend/.env. Never commit that file.
PORT=3777
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=netflix_clone_2026
# Generate a random JWT secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# If running separately, set this to the exact React URL.
CLIENT_ORIGIN=http://localhost:5173

# Used by /api/ai/recommend. Get a v3 API key from TMDB.
TMDB_API_KEY=your_tmdb_v3_api_key
# Optional: Gemini enriches/ranks TMDB titles. No key -> TMDB genre fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
