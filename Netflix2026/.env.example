# Original TMDB movie browsing still runs directly from the React frontend.
# Get a TMDB v3 API key at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_v3_api_key

# For local development, /api is forwarded to Express by Vite.
# For deployed frontends, use https://your-backend.example.com/api
VITE_AUTH_API_URL=/api
